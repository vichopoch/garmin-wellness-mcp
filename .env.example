GARMIN_MCP_TRANSPORT=streamable-http
GARMIN_MCP_HOST=0.0.0.0
GARMIN_MCP_PORT=8000
GARMIN_MCP_CALL_TIMEOUT=90
GARMIN_READ_ONLY=true
CHATGPT_TOOLSET=wellness
GARMINTOKENS=/data/garmin
GARMIN_TIMEZONE=America/Santiago
DATABASE_URL=
AUTH_MODE=oauth
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_ALLOWED_SUBJECT=
MCP_RESOURCE_URL=
LOG_LEVEL=INFO
LOG_SENSITIVE_DATA=false
GARMIN_SYNC_ENABLED=true
GARMIN_INITIAL_BACKFILL_DAYS=90
GARMIN_SYNC_LOOKBACK_DAYS=3
GARMIN_SYNC_INTERVAL_SECONDS=3600
# Fixed local times take precedence over the legacy interval above.
GARMIN_SYNC_TIMES=07:00,15:00,23:00
GARMIN_SYNC_TIMEZONE=America/Santiago
GARMIN_CACHE_TTL_SECONDS=900
GARMIN_SYNC_DAY_PAUSE_SECONDS=1
# Optional resumable complete-history import; choose a verified inclusive date.
GARMIN_HISTORY_START_DATE=
GARMIN_HISTORY_BATCH_DAYS=30
GARMIN_HISTORY_BATCH_SECONDS=120
GARMIN_HISTORY_BATCH_PAUSE_SECONDS=10
GARMIN_HISTORY_RETRY_SECONDS=900
